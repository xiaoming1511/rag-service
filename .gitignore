# ========== Python ==========
__pycache__/
*.py[cod]
*.egg-info/
.venv/

# ========== 运行产物（向量库、嵌入缓存等，可重新生成） ==========
data/
*.sqlite3

# ========== 测试与工具 ==========
.pytest_cache/
.pytest_tmp/
.pytest_tmp*/
.mypy_cache/
.coverage
htmlcov/

# ========== IDE / 系统 ==========
.idea/
.DS_Store

# ========== 运行日志与助手工作数据 ==========
logs/
.ai-memory/

# ========== AI 助手工作数据（记忆/报告，非项目代码） ==========
.workbuddy/

# ========== Obsidian 插件（node_modules 不入库；main.js 构建产物保留入库便于直接安装） ==========
obsidian-plugin/node_modules/
# 历史构建备份（手工备份产物，不入库）
obsidian-plugin/*.bak-*
# E2E 契约测试的中间产物（由 scripts/e2e-contract.mjs 生成）
obsidian-plugin/.e2e/